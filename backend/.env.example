# ── Core LLM Keys ──────────────────────────────────────────────────
GOOGLE_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash
GROQ_API_KEY=your_groq_api_key_optional

# ── Self-Deployed Gemma 4 (Vertex AI Model Garden) ─────────────────
GEMMA_PROJECT=your_gcp_project_number
GEMMA_LOCATION=europe-west4
GEMMA_ENDPOINT_ID=your_endpoint_id
GEMMA_DEDICATED_DNS=your_endpoint_id.region-project_number.prediction.vertexai.goog
GEMMA_MODEL_NAME=google/gemma-4-31b-it

# ── Storage & RAG ──────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://your_cluster_uri
MONGODB_DB_NAME=sdkgen
NOMIC_API_KEY=your_nomic_api_key
COHERE_API_KEY=your_cohere_api_key

# ── Search & Sandbox ───────────────────────────────────────────────
SERPER_API_KEY=your_serper_api_key
E2B_API_KEY=your_e2b_api_key

# ── External Services ─────────────────────────────────────────────
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_VOICE_ID=aMSt68OGf4xUZAnLpTU8
ELEVENLABS_MODEL=eleven_flash_v2

# ── Runtime ────────────────────────────────────────────────────────
DEBUG=true
PORT=8000
