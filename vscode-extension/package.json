{
  "name": "docs-to-code",
  "displayName": "Docs to Code",
  "description": "Turn any API documentation URL into a fully typed, live-verified SDK — delivered directly into your workspace.",
  "version": "1.0.0",
  "publisher": "docs-to-code-team",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "sdk",
    "api",
    "docs",
    "ai",
    "codegen"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onUri"
  ],
  "main": "./out/extension.js",
  "icon": "icons/icon128.png",
  "contributes": {
    "commands": [
      {
        "command": "docs-to-code.generate",
        "title": "Docs to Code: Generate SDK",
        "category": "Docs to Code"
      },
      {
        "command": "docs-to-code.resume",
        "title": "Docs to Code: Resume Job",
        "category": "Docs to Code"
      },
      {
        "command": "docs-to-code.history",
        "title": "Docs to Code: Show Job History",
        "category": "Docs to Code"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "docs-to-code",
          "title": "Docs to Code",
          "icon": "icons/icon.svg"
        }
      ]
    },
    "views": {
      "docs-to-code": [
        {
          "id": "docs-to-code.historyView",
          "name": "Generation History",
          "when": "true"
        }
      ]
    },
    "menus": {
      "commandPalette": [
        {
          "command": "docs-to-code.generate"
        },
        {
          "command": "docs-to-code.resume"
        },
        {
          "command": "docs-to-code.history"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/eventsource": "^1.1.15",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vscode/vsce": "^3.9.1",
    "eslint": "^8.0.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "eventsource": "^4.1.0",
    "ws": "^8.16.0"
  }
}
