{
  "manifest_version": 3,
  "name": "Docs to Code",
  "short_name": "DocsToCode",
  "version": "1.0.0",
  "description": "Turn any API documentation page into a fully-typed, live-verified SDK — delivered directly into VS Code.",

  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "audioCapture"
  ],

  "host_permissions": [
    "http://localhost:8000/*",
    "ws://localhost:47291/*",
    "ws://localhost:47292/*",
    "ws://localhost:47293/*",
    "https://*.elevenlabs.io/*",
    "wss://*.elevenlabs.io/*"
  ],

  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Docs to Code",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "run_at": "document_idle"
    }
  ],

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "web_accessible_resources": [
    {
      "resources": ["icons/*", "lib/convai-widget-embed.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
